# Copy to .env. Real environment variables take precedence over this file.
# Get a private token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Public HTTPS address of the Flask server; Telegram Mini Apps require HTTPS.
BACKEND_URL=https://your-school21-app.example.com

# Comma-separated Telegram user IDs allowed to access admin APIs. Empty = no admins.
ADMIN_TELEGRAM_IDS=

# Secure Telegram authentication is the default. Local browser preview only:
# set DEMO_MODE=true; it accepts loopback requests with a fixed synthetic user,
# disables admin access and defaults to instance/demo.db. NEVER deploy demo mode.
DEMO_MODE=false

# Optional SQLite path, relative to the repository root or absolute.
# Keep demo and campus databases separate; use a persistent volume in production.
# DATABASE_PATH=backend/school21.db

# Maximum age of signed Telegram initData, in seconds; reopen the app on expiry.
INIT_DATA_MAX_AGE=86400

# Campus timezone used for booking dates and activity timestamps.
TZ=Asia/Tashkent

# Local development server. macOS often reserves port 5000.
PORT=5001
FLASK_DEBUG=false

# Gunicorn: use a small worker pool with SQLite; tune after measuring load.
WEB_CONCURRENCY=2
